# =============================================================================
# Gateway IoT EPME-TG · plantilla de variables de entorno
# Copie este archivo como .env y reemplace los valores de ejemplo.
# Nunca publique el archivo .env ni comparta sus credenciales.
# =============================================================================

# --- InfluxDB 2.7 -----------------------------------------------------------
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-influx-admin
INFLUXDB_ORG=seriot
INFLUXDB_BUCKET=datos
INFLUXDB_RETENTION=30d
INFLUXDB_TOKEN=change-me-influx-token

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# --- Zona horaria -----------------------------------------------------------
TZ=America/Bogota

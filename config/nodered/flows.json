        "name": "Normalizar payload SerIoT",
        "func": "let p = msg.payload;\nif (Buffer.isBuffer(p)) { p = p.toString('utf8'); }\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch (e) { /* mantener string */ }\n}\nif (p === null || p === undefined) { p = {}; }\nif (typeof p !== 'object' || Array.isArray(p)) {\n    p = { value: p };\n}\nmsg.payload = p;\nmsg.measurement = 'energia';\nmsg.topic = msg.topic || 'seriot';\nreturn msg;",
